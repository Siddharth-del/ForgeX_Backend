# Base URL of the ForgeX Spring Boot backend, without a trailing slash.
# Leave empty in development to use the Vite proxy below (recommended).
# Production example: VITE_API_BASE_URL=https://api.forgex.in
VITE_API_BASE_URL=

# Development only: where the Vite dev server forwards /api and /images.
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Where uploaded product images are served from. Defaults to <API base>/images.
VITE_IMAGE_BASE_URL=
