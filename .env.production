# Loaded by `npm run build` and `npm run preview`. Public values only.
# `npm run preview` (http://localhost:4173) forwards /api/... here. On Render the forwarding is done
# by the "/api/*" rewrite in render.yaml instead: put the same backend URL there.
VITE_API_PROXY_TARGET=https://YOUR-BACKEND.onrender.com
# Leave empty so the browser calls the site's own /api. Set it to the backend URL only once the
# backend sends CORS headers for your storefront's origin.
VITE_API_BASE_URL=
